{
  "expo": {
    "name": "DHA Works Worker",
    "slug": "dha-works-worker",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dhaworksworker",
    "userInterfaceStyle": "light",
    "android": {
      "package": "pk.dhaworks.worker",
      "adaptiveIcon": {
        "backgroundColor": "#0E5A3A",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "DHA Works uses the camera so you can photograph your CNIC, police certificate and profile picture.",
          "photosPermission": "DHA Works reads photos you choose for your CNIC, police certificate and profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "DHA Works uses the microphone to record your short voice introduction."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E5A3A",
          "image": "./assets/images/crest.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
