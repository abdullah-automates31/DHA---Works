# Copy to .env (gitignored). Expo inlines EXPO_PUBLIC_* into the app bundle, so only ever put
# the public URL and the anon/publishable key here, never the service-role key.
#
# Local Supabase, phone on the same Wi-Fi: use the PC's LAN address, not 127.0.0.1
# (the phone would call itself). Find it with `ipconfig`; Windows Firewall may need to allow port 55321.
EXPO_PUBLIC_SUPABASE_URL=http://192.168.x.x:55321
# `supabase status -o json` -> ANON_KEY (local) or PUBLISHABLE_KEY
EXPO_PUBLIC_SUPABASE_ANON_KEY=
