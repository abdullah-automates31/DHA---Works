{
  "name": "dha-works",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "scripts": {
    "worker": "npm run start --workspace @dha/worker",
    "worker:typecheck": "npm run typecheck --workspace @dha/worker",
    "worker:lint": "npm run lint --workspace @dha/worker",
    "worker:test": "npm run test --workspace @dha/worker",
    "admin": "npm run dev --workspace @dha/admin",
    "admin:typecheck": "npm run typecheck --workspace @dha/admin",
    "admin:lint": "npm run lint --workspace @dha/admin",
    "admin:test": "npm run test --workspace @dha/admin",
    "admin:build": "npm run build --workspace @dha/admin",
    "db:local": "node scripts/local-supabase.mjs",
    "safety:supabase": "node scripts/check-supabase-config.mjs",
    "safety:prod-ready": "node scripts/check-production-ready.mjs",
    "safety:test": "node --test \"scripts/*.test.mjs\"",
    "supabase:config-push": "node scripts/supabase-config-push.mjs"
  }
}
